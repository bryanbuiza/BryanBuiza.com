  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "particles.js": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.1"
  }
