{
  "name": "bryanbuiza.com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -p worker && astro build",
    "preview": "astro preview",
    "preview:worker": "npm run build && wrangler dev",
