---
// Un puesto de trabajo. En escritorio toda la tarjeta es clicable y,
// al pasar el mouse, se resalta mientras las demás se atenúan.
import ArrowUpRight from "./icons/ArrowUpRight.astro";
import TechTag from "./TechTag.astro";
import type { Experience } from "../data/experience";

interface Props {
  item: Experience;
}

const { item } = Astro.props;
---

<li class="mb-12">
  <div class="group relative grid pb-1 transition-all sm:grid-cols-8 sm:gap-8 md:gap-4 lg:group-hover/list:opacity-50 lg:hover:opacity-100!">
    <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-slate-800/50 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)] lg:group-hover:drop-shadow-v3-lg"></div>

    <header
      class="z-10 mt-1 mb-2 text-xs font-semibold tracking-wide text-slate-500 uppercase sm:col-span-2"
      aria-label={item.periodLabel}
    >
      {item.period}
    </header>

    <div class="z-10 sm:col-span-6">
      <h3 class="leading-snug font-medium text-slate-200">
        <a
          class="group/link inline-flex items-baseline text-base leading-tight font-medium text-slate-200 hover:text-violet-300 focus-visible:text-violet-300"
          href={item.url}
          target="_blank"
          rel="noreferrer noopener"
          aria-label={`${item.role} en ${item.company} (abre en una nueva pestaña)`}
        >
          <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded md:-inset-x-6 md:-inset-y-4 lg:block"></span>
          <span>
            {item.role} ·{" "}
            <span class="inline-block">
              {item.company}
              <ArrowUpRight />
            </span>
          </span>
        </a>
      </h3>
      <p class="mt-2 text-sm leading-normal">{item.description}</p>
      <ul class="mt-2 flex flex-wrap" aria-label="Tecnologías utilizadas">
        {item.technologies.map((tech) => (
          <TechTag>{tech}</TechTag>
        ))}
      </ul>
    </div>
  </div>
</li>
